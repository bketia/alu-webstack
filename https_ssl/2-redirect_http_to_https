global
    log /dev/log local0
    log /dev/log local1 notice
    maxconn 2048
    user haproxy
    group haproxy
    daemon
    h1-case-adjust x-served-by X-Served-By
    h1-case-adjust location Location
    tune.ssl.default-dh-param 2048

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend http_front
    bind *:80
    option h1-case-adjust-bogus-client
    http-request set-header X-Forwarded-Proto http
    redirect scheme https code 301 if !{ ssl_fc }
    default_backend http_back

frontend https_front
    bind *:443 ssl crt /etc/haproxy/certs/www.bezastudio.tech.pem alpn http/1.1
    option h1-case-adjust-bogus-client
    http-request set-header X-Forwarded-Proto https
    default_backend http_back

backend http_back
    balance roundrobin
    server 7108-web-01 18.175.244.187:80 check
    server 7108-web-02 3.8.123.78:80 check
